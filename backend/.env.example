PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-strong-random-secret

# Comma-separated list of browser origins allowed to call backend directly
FRONTEND_URL=https://your-frontend-domain.com,http://localhost:5173

# Primary frontend URL used to generate links in emails (single URL)
FRONTEND_APP_URL=https://your-frontend-domain.com

# SMTP for OTP + password reset
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASS=your-smtp-password-or-app-password
MAIL_FROM="SpendSense AI <no-reply@example.com>"
